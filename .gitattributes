# frontend_engine.h is generated by cbindgen and contains only declarations —
# there is no C source or C build system in this repo. Leaving it visible to
# linguist made GitHub detect C, which pulled a c-cpp analysis into CodeQL's
# default setup; its autobuild has nothing to build and fails.
#
# `linguist-detectable=false` rather than `linguist-generated=true`: both stop
# the detection, but `generated` would also collapse the file in pull request
# diffs, which defeats the reason it is committed — making ABI drift reviewable.
frontend_engine.h linguist-detectable=false
